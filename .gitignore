# Publish the application and user-facing documentation; keep development materials local.
/*
!/.gitignore
!/README.md
!/README.en.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Civ6WebReplay/
/data/
/AGENTS.md
/pytest.ini

# game binaries / reference build (read-only, not shipped)
CivVIReplay_v6.0/
CivVIReplay-src/

# local caches
cache/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
_scratch/
*.Civ6Save
.env
.env.*

# local one-click process cleanup
/Civ6WebReplay/stop.bat
/Civ6WebReplay/stop.ps1

# Developer databases, source archives, tools, and reports stay local.
/test/
