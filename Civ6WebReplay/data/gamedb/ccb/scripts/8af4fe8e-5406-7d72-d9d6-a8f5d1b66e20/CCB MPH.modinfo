<?xml version="1.0" encoding="utf-8"?>
<!-- <Mod id="8af4fe8e-3333-7d72-d9d6-a8f5d1b66e20" version="112"> -->
<Mod id="8af4fe8e-5406-7d72-d9d6-a8f5d1b66e20" version="113">

    <Properties>
        <!-- <Name>CCB MPH 多人游戏助手 WIP</Name> -->
        <Name>CCB MPH 多人游戏助手 1.13</Name>
        <Description>面向于电子竞技的模组，提升比赛、游戏的稳定性，并全面改善多人游戏的体验。[NEWLINE][NEWLINE][COLOR_RED]每次开启和关闭该模组时需要重启游戏以生效。[ENDCOLOR][NEWLINE][NEWLINE]否则模组中的一些功能会失效（例如征召功能）</Description>
        <Version>113</Version>
        <Created>1</Created>
        <Teaser>面向于电子竞技的模组，提升比赛和游戏的稳定性。</Teaser>
        <Authors>https://github.com/Z-Vanadium/ChineseCiv6BalanceMPH</Authors>
        <SpecialThanks>MPH</SpecialThanks>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
    </Properties>

    <ActionCriteria>
        <Criteria id="Expansion2">
            <GameCoreInUse>Expansion2</GameCoreInUse>
        </Criteria>
        <Criteria id="Expansion1">
            <GameCoreInUse>Expansion1</GameCoreInUse>
        </Criteria>


        <Criteria id="Anonymous_Mode_Expansion2">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>GAMEMODE_ANONYMOUS</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Sudden_Death_Mode_Expansion2">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>GAMEMODE_SUDDEN_DEATH</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Alliance_Military_Off">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>ALLIANCE_MILITARY</ConfigurationId>
                <Value>0</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Alliance_Cultural_Off">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>ALLIANCE_CULTURAL</ConfigurationId>
                <Value>0</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Alliance_Religious_Off">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>ALLIANCE_RELIGIOUS</ConfigurationId>
                <Value>0</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Alliance_Research_Off">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>ALLIANCE_RESEARCH</ConfigurationId>
                <Value>0</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Alliance_Economic_Off">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>ALLIANCE_ECONOMIC</ConfigurationId>
                <Value>0</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Diplomatic_Deals_Off">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>DIPLOMATIC_DEAL</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Diplomatic_FS_Off">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>NO_FRIENDSHIP</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Diplomatic_SW_Off">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>NO_SURPRISE_WAR</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
		<!--外交能见度模式(DPR)-->
		<Criteria id="SETTINGS_UI_DiplomacyRibbon" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_DPR</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!--不兼容独立的外交能见度模式DPR-->
		<Criteria id="Disable_DPR">
			<ModInUse inverse="1">00000000-0000-1103-34FC-80A16F3198D3</ModInUse>	<!--	Team PVP 外交能见度模式	-->
		</Criteria>
    </ActionCriteria>

    <FrontEndActions>
        <ImportFiles id="FrontEnd">
            <Properties>
                <LoadOrder>9999</LoadOrder>
            </Properties>
            <File>ui/gamesetuplogic.lua</File>
            <File>ui/hostgame.lua</File>
            <File>ui/hostgame.xml</File>
            <File>ui/mainmenu.lua</File>
            <File>ui/mainmenu.xml</File>
            <File>ui/playertargetlogic.lua</File>
            <File>ui/setupparameters.lua</File>
            <File>ui/stagingroom.lua</File>
            <File>ui/stagingroom.xml</File>

        </ImportFiles>

        <UpdateDatabase id="CPL_SETTINGS">
            <File>configuration/config.sql</File>
            <File>configuration/Config.xml</File>
            <File>configuration/Config_BBG.xml</File>
            <File>configuration/Config_BBS.xml</File>
            <File>configuration/Config_BSM.xml</File>
        </UpdateDatabase>
        <UpdateText id="MPH_TEXTS">
            <File>lang/Text_EN.xml</File>
            <File>lang/Text_FR.xml</File>
            <File>lang/Text_CN.xml</File>
            <File>lang/Text_RU.xml</File>
            <File>lang/Text_BR.xml</File>
            <File>lang/Text_KO.xml</File>
            <File>lang/Text_JP.xml</File>
            <File>lang/Text_DE.xml</File>
        </UpdateText>


        <UpdateIcons id="MPHIcons FrontEnd">
            <File>icons/Anonymous_Icons.xml</File>
            <File>icons/Sudden_Death_Icons.xml</File>
        </UpdateIcons>


        <ImportFiles id="FrontEnd_Arts_Icons_Import">
            <Items>
                <File>icons/Sudden_Death_44.dds</File>
                <File>mode/sudden_death/Sudden_Death_Portrait.dds</File>
                <File>mode/sudden_death/Sudden_Death_Background.dds</File>
                <File>icons/Anonymous_44.dds</File>
                <File>mode/anonymous/Anonymous_Portrait.dds</File>
                <File>mode/anonymous/Anonymous_Background.dds</File>
            </Items>
        </ImportFiles>

        
		<!--外交能见度模式(DPR)-->
		<UpdateDatabase id="Cfg_DPR" criteria="Disable_DPR">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>DPR/Config_DPR.xml</File>
		</UpdateDatabase>
		<UpdateText id="Config_Text" criteria="Disable_DPR">
			<File>DPR/Config_DPR_Text.xml</File>
		</UpdateText>
		<UpdateDatabase id="Hotkeys_DPR_Configs" criteria="Disable_DPR">
			<File>DPR/Config_Hotkeys_DPR.xml</File>
		</UpdateDatabase>

    </FrontEndActions>
    <InGameActions>
        <!-- 大将军显示时代 -->
		<ReplaceUIScript id="GreatGeneralEraReminder_Replace">
			<Properties>
				<LoadOrder>10001</LoadOrder>
				<LuaContext>UnitFlagManager</LuaContext>
				<LuaReplace>BER/UnitFlagManager_GreatGeneralEraReminder.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ImportFiles id="GreatGeneralEraReminder_Import">
			<File>BER/UnitFlagManager_GreatGeneralEraReminder.lua</File>
		</ImportFiles>

        <AddGameplayScripts id="CPL_Helper">
