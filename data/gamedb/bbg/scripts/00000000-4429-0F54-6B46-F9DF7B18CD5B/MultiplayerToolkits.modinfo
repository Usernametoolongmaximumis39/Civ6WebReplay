<?xml version="1.0" encoding="utf-8"?>
<Mod id="00000000-4429-0F54-6B46-F9DF7B18CD5B" version="20240313">
	<Properties>
		<Name>LOC_MPT_NAME</Name>
		<Description>LOC_MPT_DESCRIPTION</Description>
		<Teaser>LOC_MPT_TEASER</Teaser>
		<Authors>LOC_MPT_AUTHORS</Authors>
		<SpecialThanks></SpecialThanks>
		<AffectsSavedGames>0</AffectsSavedGames>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
	</Properties>

	<LocalizedText>
		<Text id="LOC_MPT_NAME">
			<en_US>[ENDCOLOR][ENDCOLOR][COLOR_LIGHTBLUE]Multiplayer Toolkits (UI)[ENDCOLOR]</en_US>
			<zh_Hans_CN>[ENDCOLOR][ENDCOLOR][COLOR_LIGHTBLUE]Multiplayer Toolkits (UI)[ENDCOLOR]</zh_Hans_CN>
		</Text>
		<Text id="LOC_MPT_DESCRIPTION">
			<en_US>[size_16][ICON_Bolt]Esport oriented mod with multiple UI enhancements to improve the multiplayer experience[NEWLINE][NEWLINE][ICON_CHARGES_LARGE]You can customize it in the advanced options[NEWLINE][NEWLINE][icon_You]Better Great People Panel[NEWLINE][NEWLINE][icon_You]Tech Civic Boost Ratio Fix[NEWLINE][NEWLINE][icon_You]Extended Policy Cards[NEWLINE][NEWLINE][icon_You]Top Panel Extension Pro[NEWLINE][NEWLINE][icon_You]Better City States Lite[NEWLINE][NEWLINE][icon_You]Remove Create City Confirm Popup[NEWLINE][NEWLINE][icon_You]Notification Panel Quick Clear[NEWLINE][NEWLINE][icon_You]Multiplayer Resource Visibility Sharing[NEWLINE][NEWLINE][icon_You]Better Builder Charges Tracking[NEWLINE][NEWLINE][icon_You]City Banner Refresh Fix[NEWLINE][NEWLINE][ENDCOLOR][size_20]      [ICON_LIFESPAN][NEWLINE][Size_38][NEWLINE][Size_0][ICON_ICON_TECH_LASERS][NEWLINE][Size_20][ICON_ICON_ETHNICITY_ASIAN_UNIT_GIANT_DEATH_ROBOT_PORTRAIT]</en_US>
			<zh_Hans_CN>[size_16][ICON_Bolt]面向电子竞技的模组，包含有多个UI优化工具，改善多人游戏体验[NEWLINE][NEWLINE][ICON_CHARGES_LARGE]你可以在高级设置中自定义启用[NEWLINE][NEWLINE][icon_You]伟人招募界面优化[NEWLINE][NEWLINE][icon_You]真实科文进度[NEWLINE][NEWLINE][icon_You]政策卡拓展[NEWLINE][NEWLINE][icon_You]顶部面板拓展[NEWLINE][NEWLINE][icon_You]城邦界面优化[NEWLINE][NEWLINE][icon_You]移除坐城确认弹窗[NEWLINE][NEWLINE][icon_You]通知栏快速清理[NEWLINE][NEWLINE][icon_You]团队资源能见度共享[NEWLINE][NEWLINE][icon_You]工人劳动力助手[NEWLINE][NEWLINE][icon_You]城市横幅刷新修复[NEWLINE][NEWLINE][ENDCOLOR][size_16]      [ICON_LIFESPAN][NEWLINE][Size_38][NEWLINE][Size_0][ICON_ICON_TECH_LASERS][NEWLINE][Size_20][ICON_ICON_ETHNICITY_ASIAN_UNIT_GIANT_DEATH_ROBOT_PORTRAIT]</zh_Hans_CN>
		</Text>
		<Text id="LOC_MPT_TEASER">
			<en_US>[Size_20]Esport oriented mod with multiple UI enhancements</en_US>
			<zh_Hans_CN>[Size_20]面向电子竞技的模组，包含多种UI增强功能</zh_Hans_CN>
		</Text>
		<Text id="LOC_MPT_AUTHORS">
			<en_US>[COLOR:ResGoldLabelCS]Azukii[ENDCOLOR]</en_US>
			<zh_Hans_CN>[COLOR:ResGoldLabelCS]号码菌[ENDCOLOR]</zh_Hans_CN>
		</Text>
	</LocalizedText>

	<ActionCriteria>
		<!--Better City States (BCS)-->
		<Criteria id="SETTINGS_UI_CityStates" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_BCS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>

		<Criteria id="SETTINGS_UI_CityStates_BSM_1" any="0">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_BCS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ModInUse>c6e5ad32-0600-4a98-a7cd-5854a1abcaaf</ModInUse>	<!--	Better Spectator Mod v1.2.6	-->
		</Criteria>
		
		<Criteria id="SETTINGS_UI_CityStates_BSM_2" any="0">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
			<ModInUse>c6e5ad32-0600-4a98-a7cd-5854a1abcaaf</ModInUse>	<!--	Better Spectator Mod v1.2.6	-->
		</Criteria>

		<!--Better Great People Popup (BGP)-->
		<Criteria id="SETTINGS_UI_GreatPeoplePopup" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_BGP</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!-- Better Report Screen (BRS)-->
		<Criteria id="SETTINGS_UI_BetterReportScreen" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_BRS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!-- Notification Panel Quick Clear (NQC)-->
		<Criteria id="SETTINGS_UI_NotificationPanel_QuickClear" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_NQC</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!--Tech Civic Progress Boost Ratio Fix (TCP)-->
		<Criteria id="SETTINGS_UI_TechCivicProgressPro" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_TCP</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!--Top Panel Extension Pro (TPE)-->
		<Criteria id="SETTINGS_UI_TopPanelExtension" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_TPE</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
	</ActionCriteria>

	<FrontEndActions>
		<!--Advanced Options (Settings)-->
		<UpdateDatabase id="Config_Settings">
			<Properties>
				<LoadOrder>10</LoadOrder>
			</Properties>
			<File>Settings/Config_UI.xml</File>
		</UpdateDatabase>
		<UpdateText id="Config_Text">
			<File>Settings/Config_UI_Text.xml</File>
		</UpdateText>
